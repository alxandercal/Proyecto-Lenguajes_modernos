rules_version = '2';

// Reglas de seguridad de ReFood Connect.
// La API escribe con el token del usuario, así que estas reglas se aplican siempre.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de apoyo ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function donationPath(id) { return /databases/$(database)/documents/donations/$(id); }
    function reservationPath(id) { return /databases/$(database)/documents/reservations/$(id); }
    function pickupPath(id) { return /databases/$(database)/documents/pickups/$(id); }
    function hasRole(role) {
      return signedIn() && exists(userPath(me())) && get(userPath(me())).data.role == role;
    }
    function isAdmin() { return hasRole('ADMIN'); }
    function incoming() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function exactKeys(keys) {
      return incoming().keys().hasOnly(keys) && incoming().keys().hasAll(keys);
    }
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // ---------- Perfiles ----------
    match /users/{userId} {
      allow get: if signedIn() && (me() == userId || isAdmin());
      allow list: if isAdmin();
      // Cada quien crea solo su propio perfil y nunca como ADMIN.
      allow create: if signedIn() && me() == userId
        && exactKeys(['uid', 'email', 'name', 'role', 'organizationName', 'zone', 'createdAt'])
        && incoming().uid == userId
        && incoming().email == request.auth.token.email
        && incoming().role in ['DONOR', 'RECEIVER']
        && isText(incoming().name, 2, 80)
        && isText(incoming().organizationName, 2, 100)
        && incoming().zone is string
        && incoming().createdAt is string;
      allow update, delete: if false;
    }

    // ---------- Donaciones (entidad principal) ----------
    match /donations/{donationId} {
      function validDonation(d) {
        return isText(d.title, 3, 80)
          && d.category is string
          && d.quantity is number && d.quantity > 0 && d.quantity <= 5000
          && d.unit in ['KG', 'L', 'PIEZA', 'PORCION']
          && d.quantityKg is number
          && d.expiresAt is string
          && isText(d.pickupAddress, 5, 160)
          && d.zone is string
          && d.notes is string && d.notes.size() <= 300
          && d.history is list
          && d.updatedAt is string;
      }
      function isOwner() { return signedIn() && resource.data.ownerId == me(); }
      function reservationFields() {
        return ['status', 'reservedBy', 'reservedByName', 'history', 'updatedAt'];
      }

      // Publicadas: cualquiera. Las demás: el dueño, quien la reservó o ADMIN.
      allow get, list: if resource.data.status == 'PUBLISHED'
        || (signedIn() && (resource.data.ownerId == me() || resource.data.reservedBy == me()))
        || isAdmin();

      allow create: if hasRole('DONOR')
        && exactKeys(['ownerId', 'donorName', 'title', 'category', 'quantity', 'unit',
                      'quantityKg', 'expiresAt', 'pickupAddress', 'zone', 'notes', 'status',
                      'reservedBy', 'reservedByName', 'history', 'createdAt', 'updatedAt'])
        && incoming().ownerId == me()
        && incoming().status == 'PUBLISHED'
        && incoming().reservedBy == ''
        && incoming().reservedByName == ''
        && incoming().history.size() == 1
        && incoming().createdAt is string
        && validDonation(incoming());

      // 1) Editar: el dueño, mientras siga publicada.
      allow update: if isOwner()
        && resource.data.status == 'PUBLISHED'
        && incoming().status == 'PUBLISHED'
        && changed().hasOnly(['title', 'category', 'quantity', 'unit', 'quantityKg', 'expiresAt',
                              'pickupAddress', 'zone', 'notes', 'history', 'updatedAt'])
        && validDonation(incoming());

      // 2) Cancelar: el dueño, si está publicada o reservada.
      allow update: if isOwner()
        && resource.data.status in ['PUBLISHED', 'RESERVED']
        && incoming().status == 'CANCELLED'
        && changed().hasOnly(['status', 'history', 'updatedAt']);

      // 3) Reservar: un receptor, solo junto con la creación de su reserva.
      allow update: if hasRole('RECEIVER')
        && resource.data.status == 'PUBLISHED'
        && incoming().status == 'RESERVED'
        && incoming().reservedBy == me()
        && changed().hasOnly(reservationFields())
        && existsAfter(reservationPath(donationId));

      // 4) Liberar: el receptor que la reservó, borrando su reserva en el mismo commit.
      allow update: if signedIn()
        && resource.data.status == 'RESERVED'
        && resource.data.reservedBy == me()
        && incoming().status == 'PUBLISHED'
        && incoming().reservedBy == ''
        && changed().hasOnly(reservationFields())
        && !existsAfter(reservationPath(donationId));

      // 5) Entregar: el dueño, solo junto con la evidencia en pickups.
      allow update: if isOwner()
        && resource.data.status == 'RESERVED'
        && incoming().status == 'DELIVERED'
        && changed().hasOnly(['status', 'history', 'updatedAt'])
        && existsAfter(pickupPath(donationId));

      allow delete: if isOwner() && resource.data.status == 'PUBLISHED';
    }

    // ---------- Reservas (id = id de la donación) ----------
    match /reservations/{reservationId} {
      allow get, list: if signedIn()
        && (resource.data.receiverId == me() || resource.data.donorId == me() || isAdmin());

      allow create: if hasRole('RECEIVER')
        && incoming().receiverId == me()
        && incoming().donationId == reservationId
        && incoming().status == 'ACTIVE'
        && get(donationPath(reservationId)).data.status == 'PUBLISHED'
        && incoming().donorId == get(donationPath(reservationId)).data.ownerId
        && getAfter(donationPath(reservationId)).data.status == 'RESERVED'
        && getAfter(donationPath(reservationId)).data.reservedBy == me();

      // El donador la cierra al entregar o al cancelar la donación.
      allow update: if signedIn()
        && resource.data.donorId == me()
        && resource.data.status == 'ACTIVE'
        && incoming().status in ['DELIVERED', 'CANCELLED']
        && changed().hasOnly(['status', 'updatedAt']);

      // El receptor la libera y la donación vuelve a quedar publicada.
      allow delete: if signedIn()
        && resource.data.receiverId == me()
        && resource.data.status == 'ACTIVE'
        && getAfter(donationPath(reservationId)).data.status == 'PUBLISHED';
    }

    // ---------- Evidencia de entrega (id = id de la donación) ----------
    match /pickups/{pickupId} {
      allow get, list: if signedIn()
        && (resource.data.donorId == me() || resource.data.receiverId == me() || isAdmin());

      allow create: if signedIn()
        && incoming().donorId == me()
        && incoming().donationId == pickupId
        && get(donationPath(pickupId)).data.ownerId == me()
        && get(donationPath(pickupId)).data.status == 'RESERVED'
        && incoming().receiverId == get(donationPath(pickupId)).data.reservedBy
        && incoming().quantityKg == get(donationPath(pickupId)).data.quantityKg
        && getAfter(donationPath(pickupId)).data.status == 'DELIVERED'
        && isText(incoming().receivedBy, 3, 80);

      allow update, delete: if false;
    }

    // ---------- Indicadores (documento global) ----------
    match /impactMetrics/{metricId} {
      // Solo crece junto con una entrega nueva hecha por su donador.
      function newDelivery() {
        return signedIn()
          && metricId == 'global'
          && incoming().lastPickupId is string
          && !exists(pickupPath(incoming().lastPickupId))
          && existsAfter(pickupPath(incoming().lastPickupId))
          && getAfter(pickupPath(incoming().lastPickupId)).data.donorId == me();
      }

      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if newDelivery() && incoming().deliveries == 1;
      allow update: if newDelivery() && incoming().deliveries == resource.data.deliveries + 1;
      allow delete: if false;
    }
  }
}
